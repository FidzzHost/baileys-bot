# Phone number for pairing code (no '+', no spaces). Example: 6281234567890
BOT_NUMBER=

# Auth method: "qr" or "pairing"
AUTH_METHOD=pairing

# Comma-separated owner phone numbers (international format, no '+')
OWNERS=6281234567890

# Bot prefix (single char or string). Example: . or !
PREFIX=.

# Bot display name shown in messages
BOT_NAME=BaileysBot

# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Auto-read messages (true/false)
AUTO_READ=false

# Path to session folder (multi-file auth)
SESSION_DIR=./session
